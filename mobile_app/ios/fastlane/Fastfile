default_platform(:ios)

platform :ios do
  # `flutter build ipa` yaratgan IPA'ni App Store Connect (TestFlight)'ga yuklaydi.
  # Autentifikatsiya App Store Connect API kaliti (.p8) orqali — parolsiz, 2FA'siz.
  desc "Upload the pre-built IPA to TestFlight"
  lane :upload_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: "./private_keys/AuthKey_#{ENV['ASC_KEY_ID']}.p8",
      duration: 1200,
      in_house: false
    )

    ipa_path = Dir.glob("../build/ios/ipa/*.ipa").max_by { |f| File.mtime(f) }
    UI.user_error!("IPA topilmadi: ../build/ios/ipa/*.ipa") if ipa_path.nil?

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_submission: true,                    # faqat yuklaydi, review'ga jo'natmaydi
      skip_waiting_for_build_processing: true   # Apple qayta ishlashini kutmaydi (CI tez tugaydi)
    )
  end
end
