{% extends "base.html" %}
{% load static humanize %}

{% block body_class %}gas-page group-detail-page{% endblock %}

{% block content %}
<div class="gas-shell">

  {% include "education/_group_action_shell.html" with group=g active_tab="detail" page_title="Batafsil" schedule_text=schedule_days_text|add:" · "|add:schedule_time_text %}

  <style>
    .gd-kpis {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 16px;
    }
    @media (max-width: 1180px) { .gd-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 720px)  { .gd-kpis { grid-template-columns: 1fr; } }

    .gd-kpi {
      padding: 18px 20px;
      border-radius: 18px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 12px 28px rgba(15,23,42,.05);
    }
    .gd-kpi__ico {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      margin-bottom: 12px;
      font-size: 16px;
    }
    .gd-kpi__ico--blue   { background: #dbeafe; color: #2563eb; }
    .gd-kpi__ico--green  { background: #d1fae5; color: #059669; }
    .gd-kpi__ico--amber  { background: #fef3c7; color: #d97706; }
    .gd-kpi__ico--violet { background: #ede9fe; color: #7c3aed; }
    .gd-kpi__lbl {
      display: block;
      margin: 0 0 6px;
      color: #94a3b8;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .gd-kpi__val {
      display: flex;
      align-items: baseline;
      gap: 4px;
      margin: 0 0 8px;
      color: #0f172a;
      font-size: 28px;
      font-weight: 900;
      letter-spacing: -.01em;
      line-height: 1;
    }
    .gd-kpi__val small {
      color: #94a3b8;
      font-size: 14px;
      font-weight: 600;
    }
    .gd-kpi__sub {
      color: #94a3b8;
      font-size: 12.5px;
      font-weight: 500;
    }

    .gd-card {
      border-radius: 18px;
      border: 1px solid #e5e7eb;
      background: #ffffff;
      box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 14px 32px rgba(15,23,42,.05);
      overflow: hidden;
    }
    .gd-card__head {
      padding: 18px 22px;
    }
    .gd-card__title {
      margin: 0 0 4px;
      color: #0f172a;
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -.01em;
    }
    .gd-card__sub {
      margin: 0;
      color: #94a3b8;
      font-size: 12.5px;
      font-weight: 500;
    }

    .gd-table-wrap { overflow-x: auto; }
    .gd-table {
      width: 100%;
      min-width: 760px;
      border-collapse: collapse;
    }
    .gd-table thead { background: #f8fafc; }
    .gd-table th {
      height: 42px;
      padding: 0 22px;
      color: #94a3b8;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .08em;
      text-align: left;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .gd-table td {
      height: 64px;
      padding: 0 22px;
      border-bottom: 1px solid #eef2f7;
      color: #475569;
      font-size: 13.5px;
      vertical-align: middle;
    }
    .gd-table tr:last-child td { border-bottom: 0; }
    .gd-table tr:hover td { background: #fafbfd; }

    .gd-st { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .gd-avatar {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 13px;
      font-weight: 800;
    }
    .gd-st__name {
      color: #0f172a;
      font-size: 14px;
      font-weight: 700;
      max-width: 240px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .gd-att {
      display: inline-flex;
      align-items: center;
      height: 26px;
      padding: 0 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }
    .gd-att--good   { background: #d1fae5; color: #047857; }
    .gd-att--mid    { background: #fef3c7; color: #b45309; }
    .gd-att--bad    { background: #fee2e2; color: #b91c1c; }
    .gd-att--none   { background: #f1f5f9; color: #94a3b8; }

    .gd-pay {
      display: inline-flex;
      align-items: center;
      height: 26px;
      padding: 0 12px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .gd-pay--paid    { background: #d1fae5; color: #047857; }
    .gd-pay--partial { background: #fef3c7; color: #b45309; }
    .gd-pay--unpaid  { background: #fee2e2; color: #b91c1c; }
    .gd-pay--none    { background: #f1f5f9; color: #94a3b8; }

    .gd-row-actions {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: #94a3b8;
      cursor: pointer;
      transition: background .15s, color .15s;
    }
    .gd-row-actions:hover { background: #f1f5f9; color: #0f172a; }

    .gd-empty {
      padding: 60px 20px;
      text-align: center;
      color: #94a3b8;
      font-size: 13.5px;
    }
    .gd-empty i {
      display: block;
      margin: 0 auto 10px;
      font-size: 28px;
      color: #cbd5e1;
    }
    .gd-empty .gd-empty__btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 14px;
      height: 38px;
      padding: 0 16px;
      border-radius: 10px;
      background: #2563eb;
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
    }
    .gd-empty .gd-empty__btn:hover { background: #1d4ed8; }
  </style>

  <div class="gd-kpis">
    <div class="gd-kpi">
      <span class="gd-kpi__ico gd-kpi__ico--blue"><i class="fa-solid fa-users"></i></span>
      <span class="gd-kpi__lbl">O'quvchilar</span>
      <span class="gd-kpi__val">{{ kpi_enrolled }}<small>/ {{ kpi_capacity }}</small></span>
      <span class="gd-kpi__sub">{{ kpi_fill_pct }}% to'ldirilgan</span>
    </div>
    <div class="gd-kpi">
      <span class="gd-kpi__ico gd-kpi__ico--green"><i class="fa-solid fa-circle-check"></i></span>
      <span class="gd-kpi__lbl">Davomat</span>
      <span class="gd-kpi__val">{{ kpi_att_rate }}<small>%</small></span>
      <span class="gd-kpi__sub">So'nggi 30 kun</span>
    </div>
    <div class="gd-kpi">
      <span class="gd-kpi__ico gd-kpi__ico--amber"><i class="fa-solid fa-money-bill-wave"></i></span>
      <span class="gd-kpi__lbl">Oylik tushum</span>
      <span class="gd-kpi__val">{{ kpi_monthly_rev|intcomma }}<small>so'm</small></span>
      <span class="gd-kpi__sub">{% if kpi_avg_per_oy %}{{ kpi_avg_per_oy|intcomma }} so'm/oy{% else %}—{% endif %}</span>
    </div>
    <div class="gd-kpi">
      <span class="gd-kpi__ico gd-kpi__ico--violet"><i class="fa-regular fa-calendar"></i></span>
      <span class="gd-kpi__lbl">Jadval</span>
      <span class="gd-kpi__val" style="font-size:22px">{{ schedule_days_text }}</span>
      <span class="gd-kpi__sub">{% if schedule_time_text %}{{ schedule_time_text }}{% endif %}{% if schedule_room_text %} · {{ schedule_room_text }}{% endif %}</span>
    </div>
  </div>

  <div class="gd-card">
    <div class="gd-card__head">
      <h2 class="gd-card__title">O'quvchilar ro'yxati</h2>
      <p class="gd-card__sub">{{ kpi_enrolled }} ta · {{ students_paid_count }} to'lagan</p>
    </div>

    {% if student_rows %}
    <div class="gd-table-wrap">
      <table class="gd-table">
        <thead>
          <tr>
            <th>Ism familiya</th>
            <th>Qo'shilgan</th>
            <th>Davomat</th>
            <th>To'lov</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for r in student_rows %}
          <tr>
            <td>
              <div class="gd-st">
                <span class="gd-avatar" style="background:{{ r.bg }};color:{{ r.color }}">{{ r.initials }}</span>
                <span class="gd-st__name" title="{{ r.name }}">{{ r.name }}</span>
              </div>
            </td>
            <td>{% if r.joined %}{{ r.joined|date:"d M Y" }}{% else %}—{% endif %}</td>
            <td>
              {% if r.att_rate >= 90 %}
                <span class="gd-att gd-att--good">{{ r.att_rate }} %</span>
              {% elif r.att_rate >= 75 %}
                <span class="gd-att gd-att--mid">{{ r.att_rate }} %</span>
              {% elif r.att_rate > 0 %}
                <span class="gd-att gd-att--bad">{{ r.att_rate }} %</span>
              {% else %}
                <span class="gd-att gd-att--none">—</span>
              {% endif %}
            </td>
            <td>
              <span class="gd-pay gd-pay--{{ r.pay_kind }}">{{ r.pay_label }}</span>
            </td>
            <td>
              <a href="{% url 'education:student_detail' student_id=r.id %}" class="gd-row-actions" title="O'quvchini ko'rish" aria-label="O'quvchini ko'rish"><i class="fa-solid fa-arrow-right"></i></a>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="gd-empty">
      <i class="fa-regular fa-user-plus"></i>
      Ushbu guruhda hali o'quvchilar yo'q.
      <div>
        <a href="{% url 'education:add_student_to_group' pk=g.id %}" class="gd-empty__btn"><i class="fa-solid fa-user-plus"></i><span>O'quvchi qo'shish</span></a>
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
