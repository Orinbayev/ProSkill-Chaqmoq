# ============================================================
# ChaqmoqApp - Environment Variables Example
# Ushbu faylni .env nomi bilan ko'chirib, real qiymatlarni to'ldiring.
# .env faylni hech qachon git'ga push qilmang!
# ============================================================

# ===== Django Core =====
SECRET_KEY=your-very-secret-django-key-here
MODE=local  # local | render | production

# ===== Database (faqat render/production uchun) =====
DB_ENGINE=django.db.backends.postgresql
DB_NAME=chaqmoqapp_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# ===== Local Database =====
LOCAL_DB_ENGINE=django.db.backends.sqlite3
LOCAL_DB_NAME=db.sqlite3

# ===== Local mobile phone testing =====
# macOS: ipconfig getifaddr en0
# Django for phone: python manage.py runserver 0.0.0.0:8000
LOCAL_DEV_HOST=192.168.1.153
LOCAL_DEFAULT_CENTER_SLUG=test

# ===== Click To'lov Tizimi =====
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_RETURN_URL=https://chaqmoqapp.uz/platform/

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=ChaqmoqApp_Student_Bot
# Family bot (ota-ona/o'quvchi paneli) username — ota-ona ulanish linki shu botga boradi.
# Alohida Family bot bo'lmasa, TELEGRAM_BOT_USERNAME bilan bir xil qoldiring.
TELEGRAM_BOT_USERNAME_FAMILY=ChaqmoqApp_Student_Bot
TELEGRAM_GROUP_ID=your_telegram_group_id
TELEGRAM_BACKUP_CHAT_ID=your_backup_group_chat_id
TELEGRAM_BOT_ENABLED=true
BOT_INTERNAL_API_URL=http://127.0.0.1:8080

# ===== Telegram Database Backup =====
BACKUP_TIMEZONE=Asia/Tashkent
BACKUP_SEND_TIME=18:00
BACKUP_KEEP_DAYS=7
TELEGRAM_ZIP_MIN_SIZE_MB=8
TELEGRAM_SEND_TIMEOUT_LARGE=180
TELEGRAM_SEND_RETRIES=2
BACKUP_GDRIVE_ENABLED=false
ADMIN_TELEGRAM_IDS=123456789,987654321

# ===== Google Gemini AI =====
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Cloudinary (Media fayllar) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== Billing Sozlamalari =====
BILLING_GRACE_PERIOD_HOURS=72
BILLING_EXPIRY_WARN_DAYS=7

# ===== Til va Vaqt =====
LANGUAGE_CODE=uz
TIME_ZONE=Asia/Tashkent
